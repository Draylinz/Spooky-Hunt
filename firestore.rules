rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hunt clock / schedule
    match /state/{doc} {
      allow read, write: if true;
    }

    // Teams and scores
    match /teams/{teamId} {
      allow read, delete: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.points == 0;
      allow update: if request.resource.data.points is int
                    && request.resource.data.points >= 0
                    && request.resource.data.points <= 2000
                    && request.resource.data.name == resource.data.name;
    }

    // Gallery entries
    match /uploads/{id} {
      allow read, create, delete: if true;
    }

    // Group chat
    match /chat/{id} {
      allow read, delete: if true;
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() <= 600;
    }

    // Live events (players may only set a bonus's "claimedBy")
    match /events/{id} {
      allow read, create, delete: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy']);
    }

    // Live locations (opt-in, during the hunt only; one doc per player, overwritten as they move)
    match /locations/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.lat is number
                            && request.resource.data.lng is number
                            && request.resource.data.name is string
                            && request.resource.data.name.size() <= 40
                            && request.resource.data.keys().hasOnly(['name', 'team', 'teamId', 'lat', 'lng', 'acc', 'updatedAt']);
    }

    // End-of-game votes (one doc per player per poll; can't vote for your own team)
    match /votes/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['run', 'poll', 'voter', 'voterTeam', 'uploadId', 'forTeam', 'at'])
                            && request.resource.data.voter is string
                            && request.resource.data.voter.size() <= 40
                            && request.resource.data.voterTeam is string
                            && request.resource.data.voterTeam != request.resource.data.forTeam;
    }

    // Poll payouts (written once per poll; the same transaction adds the points)
    match /awards/{id} {
      allow read, delete: if true;
      allow create: if request.resource.data.keys().hasOnly(['run', 'poll', 'title', 'winners', 'teams', 'votes', 'at']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
